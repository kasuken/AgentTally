{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentTally",
  "version": "0.5.0",
  "identifier": "dev.agenttally.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentTally",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#f4f6fa"
      },
      {
        "label": "buddy",
        "url": "buddy.html",
        "title": "AgentTally · Compact status",
        "width": 364,
        "height": 274,
        "visible": false,
        "focus": false,
        "decorations": false,
        "backgroundColor": "#f4f6fa",
        "alwaysOnTop": true,
        "closable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "See what your local AI coding agents are doing",
    "longDescription": "Follow local coding-agent sessions as they work, see which projects need your attention, and explore reported AI usage and estimated impact. Your data stays on your machine."
  }
}
